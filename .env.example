# ====================================================================
# TECFLIX - Configuración de Variables de Entorno
# ====================================================================

# Puerto del Servidor API
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Secreto para Tokens JWT de Autenticación
JWT_SECRET=tecflix_ultra_violet_secret_jwt_key_2026

# Conexión a Base de Datos PostgreSQL
# Puedes usar DATABASE_URL o las variables PG* individuales:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tecflix_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tecflix_db

# Almacenamiento de Videos: Google Cloud Storage (GCS)
# Modos disponibles: 'gcs' (usar Google Cloud Storage) o 'local' (almacenamiento en disco local con fallback HTTP Range)
STORAGE_DRIVER=local
GCS_PROJECT_ID=tecflix-cloud-media
GCS_BUCKET_NAME=tecflix-global-videos-prod
# Ruta al archivo JSON con credenciales de cuenta de servicio de GCP
GCS_KEY_FILE=./gcs-service-account.json
